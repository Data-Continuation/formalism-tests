{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/formalism-proof-package-registry.schema.json",
  "title": "Formalism Proof Package Registry",
  "type": "object",
  "required": [
    "schema",
    "repository",
    "source_of_truth",
    "authority_boundary",
    "packages",
    "active_issue_ownership",
    "coordination_issue_ownership",
    "policy",
    "release_state",
    "manual_user_tasks_required"
  ],
  "properties": {
    "schema": {"const": "stegverse.formalism-tests.proof-package-registry.v1"},
    "repository": {"const": "Data-Continuation/formalism-tests"},
    "source_of_truth": {"const": "FORMALISM_TESTS_MIRROR_HANDOFF.md"},
    "authority_boundary": {
      "type": "object",
      "required": [
        "execution_authority_granted",
        "publication_authority_granted",
        "release_authority_granted",
        "certification_authority_granted",
        "financial_authority_granted",
        "sovereign_authority_granted"
      ],
      "properties": {
        "execution_authority_granted": {"const": false},
        "publication_authority_granted": {"const": false},
        "release_authority_granted": {"const": false},
        "certification_authority_granted": {"const": false},
        "financial_authority_granted": {"const": false},
        "sovereign_authority_granted": {"const": false}
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["package_id", "authority_posture", "bounded_result", "canonical_owner", "downstream_activation"],
            "properties": {
              "package_id": {"const": "denial-reachability"},
              "authority_posture": {"const": "REPRODUCTION_EVIDENCE_ONLY"},
              "bounded_result": {"const": "PASS"},
              "canonical_owner": {"type": "object", "required": ["issue"], "properties": {"issue": {"const": 3}}},
              "downstream_activation": {"const": "PROHIBITED_UNTIL_CANONICAL_EVIDENCE"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["package_id", "authority_posture", "bounded_result", "canonical_owner", "downstream_activation"],
            "properties": {
              "package_id": {"const": "fi-transition-continuity-interoperability"},
              "authority_posture": {"const": "CONTINUITY_INTEROPERABILITY_ONLY"},
              "bounded_result": {"const": "PASS"},
              "canonical_owner": {"type": "object", "required": ["issue"], "properties": {"issue": {"const": 4}}},
              "downstream_activation": {"const": "PROHIBITED_UNTIL_CANONICAL_EVIDENCE"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["package_id", "authority_posture", "bounded_result", "canonical_owner", "downstream_owner", "downstream_activation"],
            "properties": {
              "package_id": {"const": "morrison-runtime-commit-time-scope"},
              "authority_posture": {"const": "EXTERNAL_FRAMEWORK_COMPARATIVE_EVIDENCE_ONLY"},
              "bounded_result": {"const": "PASS"},
              "canonical_owner": {"type": "object", "required": ["issue"], "properties": {"issue": {"const": 5}}},
              "downstream_owner": {
                "type": "object",
                "required": ["repository", "issue", "state"],
                "properties": {
                  "repository": {"const": "StegVerse-Labs/admissibility-wiki"},
                  "issue": {"const": 39},
                  "state": {"const": "WAITING_FOR_UPSTREAM"}
                }
              },
              "downstream_activation": {"const": "PROHIBITED_UNTIL_CANONICAL_EVIDENCE"}
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["package_id", "authority_posture", "bounded_result", "canonical_owner", "downstream_activation", "package_handoff", "installed_surfaces"],
            "properties": {
              "package_id": {"const": "optimization-target-commit-boundary"},
              "authority_posture": {"const": "FORMALISM_TEST_EVIDENCE_ONLY"},
              "bounded_result": {"const": "CONNECTOR_REPRODUCTION_PASS"},
              "canonical_owner": {"type": "object", "required": ["issue"], "properties": {"issue": {"const": 6}}},
              "downstream_activation": {"const": "PROHIBITED_UNTIL_CANONICAL_EVIDENCE_AND_CURRENT_DESTINATION_HANDOFF"},
              "package_handoff": {"const": "docs/formalisms/OPTIMIZATION_TARGET_COMMIT_BOUNDARY_MIRROR_HANDOFF.md"},
              "installed_surfaces": {"contains": {"const": "receipts/optimization_target_connector_materialized_reproduction.json"}, "minContains": 1, "maxContains": 1}
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "authority_posture",
          "bounded_result",
          "canonical_state",
          "canonical_owner",
          "downstream_activation",
          "installed_surfaces"
        ],
        "properties": {
          "package_id": {
            "enum": [
              "denial-reachability",
              "fi-transition-continuity-interoperability",
              "morrison-runtime-commit-time-scope",
              "optimization-target-commit-boundary"
            ]
          },
          "authority_posture": {"type": "string", "minLength": 1},
          "bounded_result": {"type": "string", "minLength": 1},
          "canonical_state": {"enum": ["PENDING_CANONICAL_EXECUTION", "VERIFIED_CANONICAL_RUN"]},
          "canonical_owner": {
            "type": "object",
            "required": ["repository", "issue"],
            "properties": {
              "repository": {"const": "Data-Continuation/formalism-tests"},
              "issue": {"enum": [3, 4, 5, 6]}
            },
            "additionalProperties": false
          },
          "downstream_owner": {
            "type": "object",
            "required": ["repository", "issue", "state"],
            "properties": {
              "repository": {"type": "string", "minLength": 1},
              "issue": {"type": "integer", "minimum": 1},
              "state": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "downstream_activation": {"type": "string", "pattern": "^PROHIBITED_"},
          "package_handoff": {"type": "string", "minLength": 1},
          "installed_surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "active_issue_ownership": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"type": "object", "properties": {"issue": {"const": 3}}, "required": ["issue"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"issue": {"const": 4}}, "required": ["issue"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"issue": {"const": 5}}, "required": ["issue"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"issue": {"const": 6}}, "required": ["issue"]}, "minContains": 1, "maxContains": 1}
      ],
      "items": {
        "type": "object",
        "required": ["issue", "workload"],
        "properties": {
          "issue": {"enum": [3, 4, 5, 6]},
          "workload": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "coordination_issue_ownership": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "issue",
          "workload",
          "authority_posture",
          "status",
          "contract",
          "handoff",
          "canonical_proof_issues_satisfied"
        ],
        "properties": {
          "issue": {"const": 7},
          "workload": {"const": "bind proof-package registry validation to an existing CI workflow"},
          "authority_posture": {"const": "REGISTRY_CONSISTENCY_ONLY"},
          "status": {"enum": ["PENDING_EXISTING_WORKFLOW_BINDING", "VERIFIED_EXISTING_WORKFLOW_BINDING"]},
          "contract": {"const": "status/formalism_proof_package_registry_ci_binding.pending.json"},
          "handoff": {"const": "docs/formalisms/FORMALISM_PROOF_PACKAGE_REGISTRY_CI_BINDING_MIRROR_HANDOFF.md"},
          "canonical_proof_issues_satisfied": {"type": "array", "maxItems": 0}
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "one_active_owner_per_workload",
        "duplicate_issue_owned_workloads_prohibited",
        "connector_reproduction_is_not_canonical_execution",
        "documentation_is_not_proof",
        "canonical_pass_is_not_downstream_authority",
        "release_requires_governed_downstream_validation"
      ],
      "properties": {
        "one_active_owner_per_workload": {"const": true},
        "duplicate_issue_owned_workloads_prohibited": {"const": true},
        "connector_reproduction_is_not_canonical_execution": {"const": true},
        "documentation_is_not_proof": {"const": true},
        "canonical_pass_is_not_downstream_authority": {"const": true},
        "release_requires_governed_downstream_validation": {"const": true}
      },
      "additionalProperties": false
    },
    "release_state": {"const": "NOT_AUTHORIZED"},
    "manual_user_tasks_required": {"type": "array", "maxItems": 0}
  },
  "additionalProperties": false
}
