{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/formalism-proof-package-registry.schema.json",
  "title": "Formalism Proof Package Registry",
  "type": "object",
  "required": [
    "schema",
    "repository",
    "source_of_truth",
    "authority_boundary",
    "packages",
    "active_issue_ownership",
    "policy",
    "release_state",
    "manual_user_tasks_required"
  ],
  "properties": {
    "schema": {"const": "stegverse.formalism-tests.proof-package-registry.v1"},
    "repository": {"const": "Data-Continuation/formalism-tests"},
    "source_of_truth": {"const": "FORMALISM_TESTS_MIRROR_HANDOFF.md"},
    "authority_boundary": {
      "type": "object",
      "required": [
        "execution_authority_granted",
        "publication_authority_granted",
        "release_authority_granted",
        "certification_authority_granted",
        "financial_authority_granted",
        "sovereign_authority_granted"
      ],
      "properties": {
        "execution_authority_granted": {"const": false},
        "publication_authority_granted": {"const": false},
        "release_authority_granted": {"const": false},
        "certification_authority_granted": {"const": false},
        "financial_authority_granted": {"const": false},
        "sovereign_authority_granted": {"const": false}
      },
      "additionalProperties": false
    },
    "packages": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "authority_posture",
          "bounded_result",
          "canonical_state",
          "canonical_owner",
          "downstream_activation",
          "installed_surfaces"
        ],
        "properties": {
          "package_id": {"type": "string", "minLength": 1},
          "authority_posture": {"type": "string", "minLength": 1},
          "bounded_result": {"type": "string", "minLength": 1},
          "canonical_state": {"enum": ["PENDING_CANONICAL_EXECUTION", "VERIFIED_CANONICAL_RUN"]},
          "canonical_owner": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["repository", "issue"],
                "properties": {
                  "repository": {"const": "Data-Continuation/formalism-tests"},
                  "issue": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              }
            ]
          },
          "downstream_owner": {
            "type": "object",
            "required": ["repository", "issue", "state"],
            "properties": {
              "repository": {"type": "string", "minLength": 1},
              "issue": {"type": "integer", "minimum": 1},
              "state": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "downstream_activation": {"type": "string", "pattern": "^PROHIBITED_"},
          "package_handoff": {"type": "string", "minLength": 1},
          "installed_surfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "active_issue_ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue", "workload"],
        "properties": {
          "issue": {"type": "integer", "minimum": 1},
          "workload": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "one_active_owner_per_workload",
        "duplicate_issue_owned_workloads_prohibited",
        "connector_reproduction_is_not_canonical_execution",
        "documentation_is_not_proof",
        "canonical_pass_is_not_downstream_authority",
        "release_requires_governed_downstream_validation"
      ],
      "properties": {
        "one_active_owner_per_workload": {"const": true},
        "duplicate_issue_owned_workloads_prohibited": {"const": true},
        "connector_reproduction_is_not_canonical_execution": {"const": true},
        "documentation_is_not_proof": {"const": true},
        "canonical_pass_is_not_downstream_authority": {"const": true},
        "release_requires_governed_downstream_validation": {"const": true}
      },
      "additionalProperties": false
    },
    "release_state": {"const": "NOT_AUTHORIZED"},
    "manual_user_tasks_required": {"type": "array", "maxItems": 0}
  },
  "additionalProperties": false
}
