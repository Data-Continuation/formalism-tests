{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stegverse.org/schemas/mindforge-boundary-semantics-canonical-execution-evidence.schema.json",
  "title": "MindForge Boundary Semantics Canonical Execution Evidence",
  "type": "object",
  "required": [
    "schema",
    "suite_id",
    "repository",
    "commit_sha",
    "execution_surface",
    "run_id",
    "commands",
    "task_results",
    "artifact_hashes",
    "artifact_equivalence",
    "status",
    "authority_posture"
  ],
  "properties": {
    "schema": {
      "const": "stegverse.mindforge-boundary-semantics.canonical-execution-evidence.v1"
    },
    "suite_id": {
      "const": "mindforge-boundary-semantics-v1"
    },
    "repository": {
      "const": "Data-Continuation/formalism-tests"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "execution_surface": {
      "const": "GITHUB_ACTIONS"
    },
    "run_id": {
      "type": "integer",
      "minimum": 1
    },
    "commands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "task_results": {
      "type": "object"
    },
    "artifact_hashes": {
      "type": "object"
    },
    "artifact_equivalence": {
      "type": "object"
    },
    "status": {
      "const": "VERIFIED_CANONICAL_RUN"
    },
    "authority_posture": {
      "const": "ARCHITECTURAL_BOUNDARY_SEMANTICS_ONLY"
    }
  },
  "additionalProperties": false
}
