{
  "name": "formalism-tests declared tasks",
  "version": "0.4.0",
  "description": "Repo-local task declarations for Data-Continuation/formalism-tests. The workflow remains generic; this file declares what should run.",
  "tasks": [
    {
      "task_id": "archive_runtime_artifacts",
      "enabled": true,
      "description": "Apply runtime artifact rules before running tests so root-level generated files are moved into legacy archive storage.",
      "command": [
        "python",
        "tools/apply_runtime_artifact_rules.py",
        "tools/rules/runtime_artifact_rules.json"
      ],
      "expected_outputs": []
    },
    {
      "task_id": "continuation_gate",
      "enabled": true,
      "description": "Run the base continuation gate.",
      "command": [
        "python",
        "src/continuation_gate.py"
      ],
      "expected_outputs": [
        "continuation_gate_report.json"
      ]
    },
    {
      "task_id": "compound_continuation_gate",
      "enabled": true,
      "description": "Run Stage 3 compound continuation proof cases.",
      "command": [
        "python",
        "src/compound_continuation_gate.py"
      ],
      "expected_outputs": [
        "reports/compound_receipts.jsonl",
        "reports/compound_continuation_report.md"
      ]
    },
    {
      "task_id": "transition_table_gate",
      "enabled": true,
      "description": "Run Stage 4 transition table integration proof cases.",
      "command": [
        "python",
        "src/transition_table_gate.py"
      ],
      "expected_outputs": [
        "reports/transition_table_receipts.jsonl",
        "reports/transition_table_report.md"
      ]
    }
  ]
}
