{
  "schema": "stegverse.declared_tasks.v1",
  "task_manifest": "tools/tasks/formalism_tests_tasks.json",
  "policy": {
    "no_new_workflow_unless_existing_cannot_express_task": true,
    "presentation_pages_do_not_become_proof_authority": true,
    "site_mirror_update_runs_after_stage6_passes": true
  },
  "tasks": [
    {
      "task_id": "archive_runtime_artifacts",
      "enabled": true,
      "description": "Archive old runtime outputs to legacy/runtime-artifacts/.",
      "runner": "tools/apply_runtime_artifact_rules.py",
      "runner_args": ["tools/rules/runtime_artifact_rules.json"]
    },
    {
      "task_id": "continuation_gate",
      "enabled": true,
      "description": "Stage 2 data continuation gate.",
      "runner": "src/validate_expected_outcomes.py"
    },
    {
      "task_id": "compound_continuation_gate",
      "enabled": true,
      "description": "Stage 3 compound continuation gate.",
      "runner": "src/compound_continuation_gate.py"
    },
    {
      "task_id": "transition_table_gate",
      "enabled": true,
      "description": "Stage 4 transition table gate.",
      "runner": "src/transition_table_gate.py"
    },
    {
      "task_id": "boundary_transition_gate",
      "enabled": true,
      "description": "Stage 5 boundary transition gate.",
      "runner": "src/boundary_transition_gate.py"
    },
    {
      "task_id": "stage6_unified_gate_tests",
      "enabled": true,
      "description": "Stage 6 unified AE gate — 10 candidates, 320 assertions.",
      "runner": "tools/run_stage6_unified_gate_tests.py",
      "outputs": [
        "reports/stage6_unified_gate_report.json",
        "reports/stage6_unified_gate_receipts.jsonl",
        "reports/current/stage6_unified_gate_report.json"
      ]
    },
    {
      "task_id": "transition_table_public_surface_tests",
      "enabled": true,
      "description": "Validate transition table as public proof surface.",
      "runner": "tools/run_transition_table_public_surface_tests.py"
    },
    {
      "task_id": "representation_non_consequence_tests",
      "enabled": true,
      "description": "Representation Non-Consequence direct coverage.",
      "runner": "tools/run_representation_non_consequence_tests.py"
    },
    {
      "task_id": "site_mirror_integrity_tests",
      "enabled": true,
      "description": "Validate Site mirror alignment with proof authority.",
      "runner": "tools/run_site_mirror_integrity_tests.py"
    },
    {
      "task_id": "current_report_preservation_tests",
      "enabled": true,
      "description": "Validate stable reports/current/ preservation.",
      "runner": "tools/run_current_report_preservation_tests.py"
    },
    {
      "task_id": "theorem_map_consistency_tests",
      "enabled": true,
      "description": "Validate root and current theorem maps agree with latest reports.",
      "runner": "tools/run_theorem_map_consistency_tests.py"
    },
    {
      "task_id": "site_mirror_update",
      "enabled": true,
      "description": "Read verified proof outputs from reports/current/ and write updated data files to Site/data/formalism-tests/. Runs automatically after stage6_unified_gate_tests passes. This is the only path by which Site data files are updated.",
      "runner": "tools/run_site_mirror_update.py",
      "depends_on": [
        "stage6_unified_gate_tests",
        "site_mirror_integrity_tests",
        "current_report_preservation_tests"
      ],
      "outputs": [
        "reports/site_mirror_update_receipt.json"
      ],
      "authority_note": "formalism-tests produces receipts. Site publishes receipts. Site must not become the authority for receipts."
    },
    {
      "task_id": "element_dependency_closure_tests",
      "enabled": false,
      "description": "Validate that every unlocked transition element has declared dependencies and no Level 5 element depends on an uncovered element without an explicit boundary. Enables formal AI Block composition verification.",
      "runner": "tools/run_element_dependency_closure_tests.py",
      "status": "next_target"
    }
  ]
}
