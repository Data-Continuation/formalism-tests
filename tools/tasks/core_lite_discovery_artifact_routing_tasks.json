{
  "manifest_name": "core lite discovery artifact routing tasks",
  "manifest_version": "0.2.0",
  "schema": "stegverse_declared_task_manifest.v1",
  "tasks": [
    {
      "command": [
        "python",
        "tools/route_core_lite_discovery_artifacts.py"
