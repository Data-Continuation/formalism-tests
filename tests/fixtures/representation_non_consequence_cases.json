{
  "schema": "stegverse_representation_non_consequence_cases.v1",
  "theorem": "Representation Non-Consequence",
  "claim": "Representation alone has no consequence-bearing status until it is bound to a transition role and continuation path.",
  "cases": [
    {
      "case_id": "rnc-representation-only-001",
      "datum_id": "patient-risk-text-001",
      "content_class": "clinical_risk_text",
      "representation_state": "stored_text",
      "role": null,
      "transition": null,
      "continuation_path": null,
      "consequence_binding": false,
      "authority_required": false,
      "expected_decision": "NO_CONSEQUENCE",
      "basis": "datum is represented but not bound to a consequence-bearing role or transition"
    },
    {
      "case_id": "rnc-representation-display-001",
      "datum_id": "patient-risk-text-001",
      "content_class": "clinical_risk_text",
      "representation_state": "displayed_text",
      "role": null,
      "transition": null,
      "continuation_path": null,
      "consequence_binding": false,
      "authority_required": false,
      "expected_decision": "NO_CONSEQUENCE",
      "basis": "displaying a representation does not itself create continuation authority"
    },
    {
      "case_id": "rnc-informational-note-001",
      "datum_id": "patient-risk-text-001",
      "content_class": "clinical_risk_text",
      "representation_state": "text_bound_to_role",
      "role": "informational_note",
      "transition": "clinical_information_continuation",
      "continuation_path": "human_review_context",
      "consequence_binding": true,
      "authority_required": true,
      "authority_present": true,
      "capacity_sufficient": true,
      "expected_decision": "ALLOW",
      "basis": "representation becomes consequence-bearing only after binding to informational continuation role"
    },
    {
      "case_id": "rnc-recommendation-signoff-001",
      "datum_id": "patient-risk-text-001",
      "content_class": "clinical_risk_text",
      "representation_state": "text_bound_to_role",
      "role": "clinician_recommendation",
      "transition": "clinical_recommendation_continuation",
      "continuation_path": "clinician_signoff_required",
      "consequence_binding": true,
      "authority_required": true,
      "authority_present": true,
      "capacity_sufficient": true,
      "signoff_required": true,
      "expected_decision": "ALLOW_WITH_SIGNOFF",
      "basis": "same representation becomes conditional when bound to recommendation role"
    },
    {
      "case_id": "rnc-autonomous-actuation-001",
      "datum_id": "patient-risk-text-001",
      "content_class": "clinical_risk_text",
      "representation_state": "text_bound_to_role",
      "role": "autonomous_medication_change",
      "transition": "clinical_actuation_continuation",
      "continuation_path": "autonomous_actuation",
      "consequence_binding": true,
      "authority_required": true,
      "authority_present": false,
      "capacity_sufficient": false,
      "expected_decision": "FAIL_CLOSED",
      "basis": "same representation becomes inadmissible when bound to autonomous actuation without sufficient authority"
    },
    {
      "case_id": "rnc-free-text-to-policy-001",
      "datum_id": "policy-note-001",
      "content_class": "policy_text",
      "representation_state": "stored_text",
      "role": "policy_basis",
      "transition": null,
      "continuation_path": null,
      "consequence_binding": false,
      "authority_required": false,
      "expected_decision": "NO_CONSEQUENCE",
      "basis": "policy-like representation does not become policy consequence until transition binding exists"
    },
    {
      "case_id": "rnc-policy-commit-001",
      "datum_id": "policy-note-001",
      "content_class": "policy_text",
      "representation_state": "text_bound_to_role",
      "role": "policy_basis",
      "transition": "policy_continuation",
      "continuation_path": "commit_time_policy_update",
      "consequence_binding": true,
      "authority_required": true,
      "authority_present": false,
      "capacity_sufficient": false,
      "expected_decision": "FAIL_CLOSED",
      "basis": "policy representation becomes consequence-bearing at commit path and fails without authority"
    }
  ]
}
