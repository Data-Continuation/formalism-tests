{
  "schema": "stegverse_bundle_manifest.v1",
  "bundle_id": "stage6-existing-workflow-task-bundle-fix2",
  "target_repo": "formalism-tests",
  "no_workflows": true,
  "purpose": "Run Stage 6 through the existing workflow without requiring pytest installation.",
  "fix_reason": "GitHub Actions environment did not have pytest installed.",
  "files": [
    {
      "path": "tools/run_stage6_unified_gate_tests.py",
      "action": "create",
      "description": "Standard-library Stage 6 test runner."
    },
    {
      "path": "tools/tasks/formalism_tests_tasks.json",
      "action": "replace",
      "description": "Full declared-task manifest replacement pointing Stage 6 to the standard-library runner."
    },
    {
      "path": "README.md",
      "action": "include",
      "description": "Fix explanation and verification checklist."
    },
    {
      "path": "bundle_manifest.json",
      "action": "include",
      "description": "Bundle manifest."
    }
  ],
  "stage6_task": {
    "task_id": "stage6_unified_gate_tests",
    "command": [
      "python",
      "tools/run_stage6_unified_gate_tests.py"
    ],
    "expected_outputs": []
  }
}
