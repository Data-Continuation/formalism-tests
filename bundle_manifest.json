{
  "schema": "stegverse_bundle_manifest.v1",
  "bundle_id": "representation-non-consequence-test-bundle",
  "target_repo": "formalism-tests",
  "no_workflows": true,
  "purpose": "Directly validate Representation Non-Consequence and update theorem coverage.",
  "files": [
    {
      "path": "tests/fixtures/representation_non_consequence_cases.json",
      "action": "create"
    },
    {
      "path": "tools/run_representation_non_consequence_tests.py",
      "action": "create"
    },
    {
      "path": "tools/tasks/formalism_tests_tasks.json",
      "action": "replace"
    },
    {
      "path": "THEOREM_PROOF_MAP.md",
      "action": "replace"
    },
    {
      "path": "README.md",
      "action": "include"
    },
    {
      "path": "bundle_manifest.json",
      "action": "include"
    }
  ],
  "declared_task": "representation_non_consequence_tests",
  "expected_outputs": [
    "reports/representation_non_consequence_report.json",
    "reports/representation_non_consequence_report.md",
    "reports/representation_non_consequence_receipts.jsonl"
  ]
}
