{
  "schema": "stegverse_bundle_manifest.v1",
  "bundle_id": "site-mirror-integrity-test-bundle",
  "target_repo": "formalism-tests",
  "no_workflows": true,
  "purpose": "Validate that the Site public mirror matches the latest formalism-tests proof surface.",
  "files": [
    {
      "path": "tools/run_site_mirror_integrity_tests.py",
      "action": "create"
    },
    {
      "path": "tools/tasks/formalism_tests_tasks.json",
      "action": "replace"
    },
    {
      "path": "tests/fixtures/site_mirror/transition-proof-surface.json",
      "action": "create"
    },
    {
      "path": "tests/fixtures/site_mirror/stage6-unified-gate-results.json",
      "action": "create"
    },
    {
      "path": "tests/fixtures/site_mirror/transition-discovery-map.json",
      "action": "create"
    },
    {
      "path": "tests/fixtures/site_mirror/transition-table-classes.json",
      "action": "create"
    },
    {
      "path": "tests/fixtures/site_mirror/representation-non-consequence-report.json",
      "action": "create"
    },
    {
      "path": "tests/fixtures/site_mirror/theorem-coverage-summary.json",
      "action": "create"
    },
    {
      "path": "tests/fixtures/site_mirror/site-mirror-page-contract.json",
      "action": "create"
    },
    {
      "path": "README.md",
      "action": "include"
    },
    {
      "path": "bundle_manifest.json",
      "action": "include"
    }
  ],
  "declared_task": "site_mirror_integrity_tests",
  "expected_output": "reports/site_mirror_integrity_report.json"
}
