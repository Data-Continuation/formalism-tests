{
  "schema": "stegverse_bundle_manifest.v1",
  "bundle_id": "theorem-map-consistency-test-bundle",
  "target_repo": "formalism-tests",
  "no_workflows": true,
  "purpose": "Replace stale theorem map and validate consistency against latest successful proof reports.",
  "files": [
    {
      "path": "THEOREM_PROOF_MAP.md",
      "action": "replace"
    },
    {
      "path": "tools/run_theorem_map_consistency_tests.py",
      "action": "create"
    },
    {
      "path": "tests/fixtures/theorem_map_consistency_policy.json",
      "action": "create"
    },
    {
      "path": "tools/tasks/formalism_tests_tasks.json",
      "action": "replace"
    },
    {
      "path": "README.md",
      "action": "include"
    },
    {
      "path": "bundle_manifest.json",
      "action": "include"
    }
  ],
  "declared_task": "theorem_map_consistency_tests",
  "expected_output": "reports/theorem_map_consistency_report.json"
}
