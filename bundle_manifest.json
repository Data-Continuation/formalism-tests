{
  "schema": "stegverse_bundle_manifest.v1",
  "bundle_id": "stage6-existing-workflow-task-bundle",
  "target_repo": "formalism-tests",
  "no_workflows": true,
  "purpose": "Add Stage 6 tests to the existing declared-task workflow without creating a new workflow.",
  "files": [
    {
      "path": "tools/tasks/formalism_tests_tasks.json",
      "action": "replace",
      "description": "Full declared-task manifest replacement with stage6_unified_gate_tests added."
    },
    {
      "path": "README.md",
      "action": "include",
      "description": "Instructions for running Stage 6 through the existing workflow."
    },
    {
      "path": "bundle_manifest.json",
      "action": "include",
      "description": "Bundle manifest."
    }
  ],
  "workflow_behavior": {
    "existing_workflow_name": "Data Continuation Tests",
    "task_manifest_input": "tools/tasks/formalism_tests_tasks.json",
    "stage6_task_id": "stage6_unified_gate_tests",
    "stage6_command": [
      "python",
      "-m",
      "pytest",
      "tests/test_stage6_unified_gate.py"
    ]
  },
  "expected_result": "94 passed"
}
