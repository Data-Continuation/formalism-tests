{
  "schema": "stegverse_bundle_manifest.v1",
  "bundle_id": "current-report-preservation-test-bundle",
  "target_repo": "formalism-tests",
  "no_workflows": true,
  "purpose": "Preserve latest successful proof reports under stable reports/current paths and update theorem coverage map.",
  "files": [
    {
      "path": "tools/run_current_report_preservation_tests.py",
      "action": "create"
    },
    {
      "path": "tests/fixtures/current_report_preservation_policy.json",
      "action": "create"
    },
    {
      "path": "tools/tasks/formalism_tests_tasks.json",
      "action": "replace"
    },
    {
      "path": "THEOREM_PROOF_MAP.md",
      "action": "replace"
    },
    {
      "path": "README.md",
      "action": "include"
    },
    {
      "path": "bundle_manifest.json",
      "action": "include"
    }
  ],
  "declared_task": "current_report_preservation_tests",
  "expected_output": "reports/current_report_preservation_report.json"
}
